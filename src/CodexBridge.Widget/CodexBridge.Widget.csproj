<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Konsol penceresi açılmasın: widget host bu süreci arka planda başlatıyor. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CodexBridge.Widget</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- COM sunucusu olarak kaydolabilmek için yönetilen COM birlikte çalışması gerekli. -->
    <EnableComHosting>false</EnableComHosting>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexBridge.Core\CodexBridge.Core.csproj" />
  </ItemGroup>
</Project>
